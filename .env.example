# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Empty = anyone who finds the bot can use it. Get your ID from @userinfobot.
ALLOWED_USER_IDS=

# Defaults for new users (they can change them in the chat)
DEFAULT_TIMEZONE=Europe/London

# How often the bot checks ManageBac, in minutes
POLL_INTERVAL_MINUTES=15

# Only calendar URLs on these domains are accepted (suffix match)
ALLOWED_FEED_HOSTS=managebac.com,managebac.cn

# Where the SQLite database lives
DATABASE_PATH=data/bot.sqlite3
